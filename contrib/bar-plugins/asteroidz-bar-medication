#!/usr/bin/env python3
"""Medication reminders as an asteroidz bar plugin.

Replaces the compositor's built-in `medication` module, reading and writing the
same store the waybar plugin used:

    $XDG_STATE_HOME/waybar-medication/medications.json

The store is the reason this belongs outside the compositor. Reading it means a
stat() on every arrange and a JSON parse whenever it changes, and WRITING it --
which taking a dose does -- means a rewrite-and-rename in the process that owns
the screen. None of that is compositor work, and the file is small enough that
a plugin polling it costs nothing.

    bar {
        modules-right "custom/medication,volume,clock"
        custom "medication" { exec "asteroidz-bar-medication"
                              continuous true }
    }

Left-click lists today's doses; picking one offers Take, Skip and Postpone.
The same menu adds, edits and removes the medications themselves.

TEXT ENTRY happens in the popover. A menu row marked `input` is an editable
field: the compositor already sees every keystroke while a menu is up, so a
form is rows like any other content. No dialog, no second toolkit, no window
that is not part of the bar -- and activating a row hands back every field's
contents at once, so a four-field schedule arrives as one event.
"""

import json
import os
import sys
import threading
import time
import uuid
from datetime import datetime, timedelta, timezone

ICON = "waybar-medication/pill.svg"
POLL_SECONDS = 20
POSTPONE_MINUTES = int(os.environ.get("ASTEROIDZ_MED_POSTPONE", "15"))
# How long after its time a dose still counts as due rather than missed. Matches
# the built-in module's window.
DUE_WINDOW_HOURS = 12

lock = threading.Lock()
doses = []          # [{key,name,time,scheduled,status,postponed_until,due}]
menu_level = None   # None = top, otherwise the dose key being shown


def store_path():
    state = os.environ.get("XDG_STATE_HOME")
    base = state if state else os.path.join(os.path.expanduser("~"), ".local/state")
    return os.path.join(base, "waybar-medication", "medications.json")


def load_doc():
    try:
        with open(store_path()) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_doc(doc):
    """Atomic replace: write a sibling, fsync, rename.

    "Did I take it?" is answered from this file months later, so a half-written
    one is worse than a stale one -- the same reasoning the built-in module
    spells out.
    """
    path = store_path()
    tmp = path + ".tmp"
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(tmp, "w") as f:
            json.dump(doc, f, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
        return True
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


def scheduled_today(med, day):
    """Is this medication scheduled on `day`?"""
    start = med.get("startDate")
    if start:
        try:
            s = datetime.strptime(start[:10], "%Y-%m-%d").date()
            if day < s:
                return False
            unit = med.get("frequencyUnit", "days")
            freq = int(med.get("frequency", 1) or 1)
            if unit == "days" and freq > 1:
                return (day - s).days % freq == 0
        except ValueError:
            pass
    return True


def reload_doses():
    doc = load_doc()
    if doc is None:
        with lock:
            doses.clear()
        return
    today = datetime.now().date()
    daykey = today.strftime("%Y-%m-%d")
    dose_state = doc.get("doseState") or {}
    now = datetime.now()
    out = []
    for med in doc.get("medications") or []:
        if not scheduled_today(med, today):
            continue
        name = med.get("name", "")
        mid = med.get("id", name)
        for t in med.get("times") or []:
            key = f"{mid}@{daykey}T{t}"
            st = dose_state.get(key) or {}
            status = st.get("status", "")
            postponed = st.get("postponedUntil")
            try:
                sched = datetime.strptime(f"{daykey} {t}", "%Y-%m-%d %H:%M")
            except ValueError:
                continue
            eff = sched
            if postponed:
                try:
                    eff = datetime.fromisoformat(postponed.replace("Z", "+00:00"))
                    eff = eff.astimezone().replace(tzinfo=None)
                except ValueError:
                    pass
            done = status in ("taken", "skipped")
            due = (not done and eff <= now
                   and now - eff < timedelta(hours=DUE_WINDOW_HOURS))
            out.append({"key": key, "name": name, "time": t, "scheduled": sched,
                        "status": status, "due": due,
                        "pending": not done and eff > now})
    out.sort(key=lambda d: d["time"])
    with lock:
        doses[:] = out


def render():
    with lock:
        ndue = sum(1 for d in doses if d["due"])
        nxt = next((d for d in doses if d["pending"]), None)
        due_one = next((d for d in doses if d["due"]), None)
        total = len(doses)
    if total == 0:
        # Nothing scheduled: the module has nothing to say, so it says nothing
        # rather than sitting there as an empty pill.
        return {"hidden": True}
    if ndue:
        text = due_one["name"] if ndue == 1 else f"{ndue} due"
        return {"icon": ICON, "text": text, "class": "urgent", "tint": "urgent",
                "tooltip": f"{ndue} dose(s) due now"}
    if nxt:
        return {"icon": ICON, "text": nxt["time"], "tint": "fg",
                "tooltip": f"next dose at {nxt['time']}: {nxt['name']}"}
    return {"icon": ICON, "tint": "dim", "tooltip": "all doses done today"}


def iso_utc(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def mark(key, status):
    doc = load_doc()
    if doc is None:
        return
    ds = doc.setdefault("doseState", {})
    entry = ds.setdefault(key, {})
    entry["status"] = status
    entry.pop("postponedUntil", None)
    with lock:
        d = next((x for x in doses if x["key"] == key), None)
    if d:
        hist = doc.setdefault("history", [])
        hist.insert(0, {
            "medId": key.split("@", 1)[0],
            "name": d["name"],
            "dosage": "",
            "scheduled": iso_utc(d["scheduled"]),
            "takenAt": iso_utc(datetime.now()) if status == "taken" else None,
            "status": status,
        })
        # capped exactly as the plugin that created this store capped it
        del hist[200:]
    save_doc(doc)


def clear(key):
    """Undo a take/skip: the dose goes back to pending."""
    doc = load_doc()
    if doc is None:
        return
    ds = doc.setdefault("doseState", {})
    ds.pop(key, None)
    save_doc(doc)


def postpone(key):
    doc = load_doc()
    if doc is None:
        return
    ds = doc.setdefault("doseState", {})
    ds.setdefault(key, {})["postponedUntil"] = iso_utc(
        datetime.now() + timedelta(minutes=POSTPONE_MINUTES))
    save_doc(doc)


def new_id():
    return "med-" + uuid.uuid4().hex[:16]


def medications():
    return (load_doc() or {}).get("medications") or []


def form_rows(med=None):
    """A schedule as editable rows. `edit` prefills them, which is the whole
    difference between adding and editing."""
    m = med or {}
    return [
        {"text": "Name", "value": "name", "input": True,
         "edit": m.get("name", "")},
        {"text": "Times (HH:MM, comma separated)", "value": "times",
         "input": True, "edit": ",".join(m.get("times") or [])},
        {"text": "Every N days", "value": "freq", "input": True,
         "edit": str(m.get("frequencyValue", 1) or 1)},
        {"text": "Start (YYYY-MM-DD)", "value": "start", "input": True,
         "edit": m.get("startDate", datetime.now().strftime("%Y-%m-%d"))},
    ]


def save_from_fields(fields, med_id=None):
    """Turn a submitted form into a medication. Rejects rather than saves
    something unusable -- a dose with no time would never fire."""
    name = (fields.get("name") or "").strip()
    times = [t.strip() for t in (fields.get("times") or "").split(",")
             if t.strip()]
    times = [t for t in times
             if len(t) == 5 and t[2] == ":" and t[:2].isdigit()
             and t[3:].isdigit() and int(t[:2]) < 24 and int(t[3:]) < 60]
    if not name or not times:
        return False
    try:
        freq = max(1, int((fields.get("freq") or "1").strip()))
    except ValueError:
        freq = 1
    start = (fields.get("start") or "").strip()
    try:
        datetime.strptime(start, "%Y-%m-%d")
    except ValueError:
        start = datetime.now().strftime("%Y-%m-%d")

    doc = load_doc() or {"version": 1, "medications": [], "doseState": {},
                         "history": [], "snoozeMinutes": POSTPONE_MINUTES}
    meds = doc.setdefault("medications", [])
    for m in meds:
        if med_id and m.get("id") == med_id:
            m.update(name=name, times=sorted(times), frequencyValue=freq,
                     frequencyUnit="days", startDate=start, enabled=True)
            break
    else:
        meds.append({"id": med_id or new_id(), "name": name,
                     "dosage": "", "times": sorted(times),
                     "frequencyValue": freq, "frequencyUnit": "days",
                     "startDate": start, "enabled": True})
    save_doc(doc)
    return True


def delete_medication(med_id):
    doc = load_doc()
    if doc is None:
        return
    doc["medications"] = [m for m in (doc.get("medications") or [])
                          if m.get("id") != med_id]
    # its dose state goes too, or a deleted medication keeps ticking
    doc["doseState"] = {k: v for k, v in (doc.get("doseState") or {}).items()
                        if not k.startswith(med_id + "@")}
    save_doc(doc)


def menu():
    global menu_level
    rows = []
    with lock:
        snapshot = list(doses)
        level = menu_level
    if level is None:
        if not snapshot:
            rows.append({"text": "nothing scheduled today", "value": "",
                         "enabled": False})
        for d in snapshot:
            mark_ch = {"taken": "✓", "skipped": "–"}.get(
                d["status"], "●" if d["due"] else "○")
            # EVERY dose drills down, taken ones included -- you may want to
            # undo a mistaken "taken", and a row that silently does nothing is
            # worse than one that opens a panel saying so.
            rows.append({"text": f"{mark_ch}  {d['time']}  {d['name']}",
                         "value": "d:" + d["key"], "submenu": True})
        rows.append({"separator": True})
        rows.append({"text": "Add medication…", "value": "add",
                     "submenu": True})
        if medications():
            rows.append({"text": "Manage medications", "value": "manage",
                         "submenu": True})
        return {"menu": {"item": "", "rows": rows}}

    if level == "add":
        rows.append({"text": "New medication", "value": "", "enabled": False})
        rows.append({"separator": True})
        rows += form_rows()
        rows.append({"separator": True})
        rows.append({"text": "Save", "value": "save:"})
        rows.append({"text": "‹  Cancel", "value": "back", "submenu": True})
        return {"menu": {"item": "", "rows": rows}}

    if level == "manage":
        rows.append({"text": "Medications", "value": "", "enabled": False})
        rows.append({"separator": True})
        for m in medications():
            rows.append({"text": f"{m.get('name','')}  "
                                 f"({', '.join(m.get('times') or [])})",
                         "value": "m:" + m.get("id", ""), "submenu": True})
        rows.append({"separator": True})
        rows.append({"text": "‹  Back", "value": "back", "submenu": True})
        return {"menu": {"item": "", "rows": rows}}

    if level.startswith("edit:"):
        mid = level[5:]
        med = next((m for m in medications() if m.get("id") == mid), None)
        if not med:
            return {"menu": {"item": "", "rows": []}}
        rows.append({"text": f"Edit {med.get('name','')}", "value": "",
                     "enabled": False})
        rows.append({"separator": True})
        rows += form_rows(med)
        rows.append({"separator": True})
        rows.append({"text": "Save", "value": "save:" + mid})
        rows.append({"text": "Remove", "value": "rm:" + mid})
        rows.append({"text": "‹  Back", "value": "manage", "submenu": True})
        return {"menu": {"item": "", "rows": rows}}

    if level.startswith("m:"):
        menu_level = "edit:" + level[2:]
        return menu()

    d = next((x for x in snapshot if x["key"] == level), None)
    if not d:
        return {"menu": {"item": "", "rows": []}}
    rows.append({"text": f"{d['time']}  {d['name']}", "value": "",
                 "enabled": False})
    rows.append({"separator": True})
    if d["status"]:
        rows.append({"text": f"marked {d['status']}", "value": "",
                     "enabled": False})
        rows.append({"text": "Undo", "value": "undo:" + d["key"]})
    else:
        rows.append({"text": "Take", "value": "take:" + d["key"]})
        rows.append({"text": "Skip", "value": "skip:" + d["key"]})
        rows.append({"text": f"Postpone {POSTPONE_MINUTES} min",
                     "value": "snooze:" + d["key"]})
    rows.append({"separator": True})
    rows.append({"text": "‹  All doses", "value": "back",
                 "submenu": True})
    return {"menu": {"item": "", "rows": rows}}


def emit(obj, last=[None]):
    line = json.dumps(obj, sort_keys=True)
    if obj.get("menu") is None:
        if line == last[0]:
            return
        last[0] = line
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def reader():
    global menu_level
    for line in sys.stdin:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        kind = ev.get("event")
        if kind == "click":
            menu_level = None
            reload_doses()
            emit(menu())
        elif kind == "menu":
            v = ev.get("value") or ""
            fields = ev.get("fields") or {}
            if v == "back":
                menu_level = None
                emit(menu())
            elif v in ("add", "manage") or v.startswith("m:"):
                menu_level = v
                emit(menu())
            elif v.startswith("save:"):
                mid = v[5:] or None
                if save_from_fields(fields, mid):
                    reload_doses()
                    emit(render())
                    menu_level = "manage" if mid else None
                    emit(menu())
                else:
                    # Rejected: keep the form up with what was typed rather
                    # than closing and losing it.
                    emit(menu())
            elif v.startswith("rm:"):
                delete_medication(v[3:])
                reload_doses()
                emit(render())
                menu_level = "manage"
                emit(menu())
            elif v.startswith("d:"):
                menu_level = v[2:]
                emit(menu())
            elif v.startswith(("take:", "skip:", "snooze:", "undo:")):
                verb, key = v.split(":", 1)
                if verb == "snooze":
                    postpone(key)
                elif verb == "undo":
                    clear(key)
                else:
                    mark(key, "taken" if verb == "take" else "skipped")
                reload_doses()
                emit(render())
                # An empty menu closes the panel, which is right after acting.
                menu_level = None
                emit({"menu": {"item": "", "rows": []}})


def main():
    threading.Thread(target=reader, daemon=True).start()
    while True:
        reload_doses()
        emit(render())
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
