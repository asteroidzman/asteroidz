#!/usr/bin/env python3
"""NordVPN state as an asteroidz bar plugin.

Replaces the compositor's built-in `vpn` module. It converts cleanly because
there was never anything in the compositor worth keeping: the module forked the
`nordvpn` CLI every couple of seconds and parsed its output. Doing that from a
plugin costs the compositor nothing and removes a fork-per-tick from its event
loop.

    bar {
        modules-right "custom/nordvpn,volume,clock"
        custom "nordvpn" { exec "asteroidz-bar-nordvpn"
                           continuous true }
    }

`continuous` rather than `interval`, even though this is a poll: a menu needs
the event channel, and only a streaming plugin gets one.

Left-click opens status and actions; the same menu carries the country list.
"""

import json
import os
import shutil
import subprocess
import sys
import threading
import time


def _find_cli():
    """The real `nordvpn` from PATH, resolved once, never this script.

    PATH is the right way to find a command -- hardcoding /usr/bin is wrong on
    any distribution that disagrees. What is NOT safe is running a bare name
    from a wrapper: an earlier version of this plugin was itself called
    `nordvpn`, a test harness put its directory on PATH, and the bare name
    resolved to THIS FILE. It ran itself, which ran itself. It took a machine
    down and cost a reboot.

    The protection is the identity check, not the path: search PATH as normal,
    then refuse the answer if it is us. Prefixing the plugin name makes the
    collision impossible in the first place; this makes it impossible anyway.
    """
    me = os.path.realpath(__file__)
    found = shutil.which("nordvpn")
    if found and os.path.realpath(found) != me:
        return found
    # PATH points at us (or nothing). Try again with our own directory removed
    # rather than giving up -- the real CLI may well be further down it.
    mydir = os.path.realpath(os.path.dirname(me))
    pruned = os.pathsep.join(
        d for d in os.environ.get("PATH", "").split(os.pathsep)
        if d and os.path.realpath(d) != mydir
    )
    found = shutil.which("nordvpn", path=pruned)
    return found if found and os.path.realpath(found) != me else None


CLI = _find_cli()

ICON_ON = "waybar-nordvpn/shield.svg"
ICON_OFF = "waybar-nordvpn/shield-off.svg"
POLL_SECONDS = int(os.environ.get("ASTEROIDZ_VPN_INTERVAL", "5"))
# Amber, for "connecting". Not a theme token because the theme has no word for
# in-progress; the built-in module carries the same literal for the same reason.
AMBER = "#e5a50a"

state = {
    "state": "unavailable",   # connected | connecting | disconnected | unavailable
    "country": "",
    "server": "",
    "ip": "",
    "uptime": "",
    "countries": [],
}
lock = threading.Lock()


def run(args, timeout=10):
    """Never blocks the bar: this is a plugin, so a slow CLI costs only us.

    argv[0] is replaced with the ABSOLUTE path resolved once at import, and the
    call is refused outright if no real CLI was found -- so a broken PATH gives
    an unavailable pill rather than a process that execs itself.
    """
    if not CLI:
        return ""
    try:
        p = subprocess.run([CLI] + list(args[1:]), capture_output=True,
                           text=True, timeout=timeout)
        return p.stdout or ""
    except (OSError, subprocess.SubprocessError):
        return ""


def field(text, key):
    """Pull "Key: value" out of the CLI's listing.

    It bullets some lines with "- " and spells the separator with and without a
    leading space, which is why this is a scan rather than a split.
    """
    for line in text.splitlines():
        k = line.lstrip("-  \t")
        if k.lower().startswith(key.lower()) and ":" in k:
            return k.split(":", 1)[1].strip()
    return ""


def poll_status():
    out = run(["nordvpn", "status"])
    st = field(out, "Status")
    with lock:
        if not st:
            # No Status line at all: the binary is missing, or the daemon is not
            # answering. Both are "cannot tell you", which is worth showing
            # rather than reporting Disconnected.
            state.update(state="unavailable", country="", server="", ip="",
                         uptime="")
        elif st.lower() == "connected":
            state.update(state="connected",
                         country=field(out, "Country"),
                         server=field(out, "Hostname") or field(out, "Server"),
                         ip=field(out, "IP"),
                         uptime=field(out, "Uptime"))
        elif st.lower() in ("connecting", "reconnecting"):
            state.update(state="connecting")
        else:
            state.update(state="disconnected", country="", server="", ip="",
                         uptime="")


def poll_countries():
    if state["countries"]:
        return
    out = run(["nordvpn", "countries"])
    names = []
    for tok in out.replace(",", " ").split():
        # the CLI decorates its output with box characters on some versions
        if tok[:1] in ("-", "|", "+") or not tok:
            continue
        names.append(tok)
    with lock:
        state["countries"] = names[:64]


def render():
    with lock:
        s = state["state"]
    if s == "unavailable":
        # Opt-in module: someone who configured it without nordvpn installed
        # should see that plainly rather than have the bar stay silent.
        return {"icon": ICON_OFF, "tint": "urgent", "tooltip": "nordvpn unavailable"}
    tint = {"connected": "accent", "connecting": AMBER}.get(s, "dim")
    tip = "Disconnected"
    with lock:
        if s == "connected":
            tip = " · ".join(x for x in (state["country"], state["server"],
                                         state["ip"]) if x)
        elif s == "connecting":
            tip = "Connecting"
    return {"icon": ICON_ON if s == "connected" else ICON_OFF, "tint": tint,
            "tooltip": tip}


def menu():
    """Where you are, then the verbs, then countries to connect to.

    Values are namespaced so a country called "off" could never be mistaken for
    the disconnect verb -- the built-in module used a control character for the
    same reason; a plugin just picks a prefix.
    """
    rows = []
    with lock:
        s = state["state"]
        country, ip, uptime = state["country"], state["ip"], state["uptime"]
        countries = list(state["countries"])
    if s == "connected":
        rows.append({"text": country or "Connected", "value": "",
                     "enabled": False})
        if ip:
            rows.append({"text": f"IP {ip}", "value": "", "enabled": False})
        if uptime:
            rows.append({"text": f"Up {uptime}", "value": "", "enabled": False})
        rows.append({"separator": True})
        rows.append({"text": "Disconnect", "value": "do:off"})
    else:
        rows.append({"text": "Quick Connect", "value": "do:quick"})
    if countries:
        rows.append({"separator": True})
        for c in countries:
            rows.append({"text": c.replace("_", " "), "value": "c:" + c})
    return {"menu": {"item": "", "rows": rows}}


def emit(obj, last=[None]):
    line = json.dumps(obj, sort_keys=True)
    if obj.get("menu") is None and line == last[0]:
        return
    if obj.get("menu") is None:
        last[0] = line
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def act(value):
    if value == "do:off":
        run(["nordvpn", "disconnect"], timeout=30)
        with lock:
            state.update(state="disconnected")
    elif value == "do:quick":
        with lock:
            state.update(state="connecting")
        emit(render())
        run(["nordvpn", "connect"], timeout=60)
    elif value.startswith("c:"):
        with lock:
            state.update(state="connecting")
        emit(render())
        run(["nordvpn", "connect", value[2:]], timeout=60)
    else:
        return
    poll_status()
    emit(render())


def reader():
    """Events from the compositor, on stdin, one JSON object per line."""
    for line in sys.stdin:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        kind = ev.get("event")
        if kind == "click":
            poll_countries()
            emit(menu())
        elif kind == "menu":
            v = ev.get("value") or ""
            if v:
                # In a thread: connecting takes seconds and the reader must stay
                # responsive, or the menu that asked for it cannot be dismissed.
                threading.Thread(target=act, args=(v,), daemon=True).start()


def main():
    threading.Thread(target=reader, daemon=True).start()
    while True:
        poll_status()
        emit(render())
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
