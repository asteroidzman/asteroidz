#!/usr/bin/env python3
"""Discord voice state as an asteroidz bar plugin.

This is the reference plugin, and it exists because it is a fair test: the
compositor already ships `discord` as a built-in module, so what a plugin can
and cannot reproduce is checkable rather than arguable.

It is a good plugin candidate for one reason -- ALL the real work already lives
somewhere else. songbird, DAVE, the audio thread and the gateway connection are
`discord-voiced`'s; the compositor's built-in module is only an IPC client that
reads newline-JSON off a socket and draws a pill. Moving that client out of the
compositor moves no work, it just stops the compositor from being the process
that has to survive it.

Run it as a continuous plugin -- one long-lived process, one JSON object per
update, no polling:

    bar {
        modules-right "custom/discord,volume,clock"
        custom "discord" {
            exec       "asteroidz-bar-discord"
            continuous true
        }
    }

Daemon protocol consumed (the same events bar-discord.h reads):

    status    state=idle|connecting|connected, channel=<id>, muted=<bool>
    channels  guilds[] + channels[], used here only to name the current channel
    ready     username
    ptt       active=<bool>, push-to-talk held
    error     text

A left click opens the same menu the built-in module drew -- mute, disconnect,
the push-to-talk key, daemon start/stop, then voice channels grouped by server.
The compositor renders the rows and owns the panel; this script only decides
what the rows are and what activating one means.

The one thing it cannot reproduce is the PTT key CHANGE dialog, which is a
compositor facility (it grabs the next keypress through the global-shortcuts
portal, of which the compositor is the backend). The row shows the current key
and is inert here.
"""

import json
import os
import shutil
import socket
import subprocess
import sys
import threading
import time

SOCKET = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "discord-voiced.sock"
)
def _find_daemon():
    """Where discord-voiced actually is, not where I guessed it would be.

    This was hardcoded to ~/.local/bin/discord-voiced -- one plausible install
    location out of several, and wrong for a packaged daemon in /usr/bin. The
    plugin then saw no daemon and no socket, correctly concluded there was
    nothing to act on, and hid itself: "missing totally" is what a wrong
    hardcoded path looks like from the outside. PATH is the answer; guessing
    directories is the bug.

    The realpath check costs nothing and keeps the rule uniform with the
    nordvpn wrapper: a plugin never execs itself, whatever PATH says.
    """
    override = os.environ.get("ASTEROIDZ_DISCORD_DAEMON")
    if override is not None:
        return override  # empty string means "never spawn"
    me = os.path.realpath(__file__)
    found = shutil.which("discord-voiced")
    return found if found and os.path.realpath(found) != me else ""


DAEMON = _find_daemon()

LOGO = "waybar-discord-voice/discord.svg"
MIC_MUTED = "waybar-volume/mic-mute.svg"


class State:
    def __init__(self):
        self.sock = None
        self.reset()

    def reset(self):
        self.state = "offline"
        self.channel_id = ""
        self.channel_name = ""
        self.username = ""
        self.error = ""
        self.muted = False
        self.ptt = False
        self.channels = {}      # id -> {name, guild, guild_name, people}
        self.guilds = {}        # id -> name
        self.linked = False

    def label(self):
        if self.error:
            return "Error"
        if self.state == "connected":
            return self.channel_name or "Connected"
        if self.state == "connecting":
            return "Connecting"
        if self.state == "idle":
            return "Idle"
        return "Offline"

    def render(self):
        """The bar object for the current state.

        Mirrors bar_module_refresh_discord: the logo tinted by state, plus the
        mic-mute glyph as a SECOND icon while muted. Push-to-talk held reads as
        the active look because it is the one thing worth seeing at a glance
        mid-conversation; an error outranks it.
        """
        # Hidden only when there is nothing to act on: no daemon running and
        # none installed. Installed-but-stopped keeps the pill, because
        # otherwise stopping the daemon is a one-way door -- no pill, nothing
        # to start it from. Same reasoning the built-in spells out.
        if (
            self.state == "offline"
            and not self.error
            and not self.linked
            and not (DAEMON and os.access(DAEMON, os.X_OK))
        ):
            return {"hidden": True}

        if self.ptt:
            tint = "accent"
        elif self.error:
            tint = "urgent"
        elif self.muted:
            tint = "dim"
        else:
            tint = "fg"

        tip = []
        if self.username:
            tip.append(self.username)
        if self.state == "connected" and self.channel_name:
            tip.append("in " + self.channel_name)
        if self.muted:
            tip.append("muted")
        if self.error:
            tip.append(self.error)

        return {
            "text": self.label(),
            "icon": [LOGO, MIC_MUTED] if self.muted else LOGO,
            "tint": tint,
            "class": "urgent" if self.error else ("active" if self.ptt else "flat"),
            "tooltip": " · ".join(tip),
        }


def emit(obj, last=[None], menu_ok=False):
    """Print one update, but only when something actually changed.

    The compositor gates its own redraw on a digest of everything the bar
    shows, so a repeated identical line costs nothing on that side either --
    but a plugin that chatters still wakes the event loop to parse JSON it
    will then discard. Cheaper to not send it.

    Menus are exempt: sending the same menu twice is two deliberate opens, not
    a repeat, and deduplicating them would make the second right-click do
    nothing.
    """
    line = json.dumps(obj, sort_keys=True)
    if not menu_ok:
        if line == last[0]:
            return
        last[0] = line
    sys.stdout.write(line + "\n")
    sys.stdout.flush()  # unbuffered or the bar sees nothing until we exit


def apply_event(st, ev):
    kind = ev.get("event")
    if kind == "status":
        st.state = ev.get("state") or "offline"
        st.channel_id = ev.get("channel") or ""
        st.muted = bool(ev.get("muted")) and st.state == "connected"
        if st.state == "offline":
            # Logged out but still running: the channel list belonged to that
            # session, so naming a channel from it would be a lie.
            st.channels.clear()
            st.guilds.clear()
            st.username = ""
        st.error = ""
        st.channel_name = (st.channels.get(st.channel_id) or {}).get("name", "")
    elif kind == "channels":
        st.guilds = {g["id"]: g.get("name", "") for g in ev.get("guilds") or []
                     if g.get("id")}
        st.channels = {}
        for c in ev.get("channels") or []:
            if not c.get("id"):
                continue
            st.channels[c["id"]] = {
                "name": c.get("name", ""),
                "guild": c.get("guild", ""),
                "people": len(c.get("participants") or []),
            }
        st.channel_name = (st.channels.get(st.channel_id) or {}).get("name", "")
    elif kind == "ready":
        st.username = ev.get("username") or ""
        st.error = ""
    elif kind == "ptt":
        st.ptt = bool(ev.get("active"))
    elif kind == "error":
        st.error = ev.get("text") or ""


def menu(st):
    """The rows the built-in module drew, in the same order.

    Grouped by server rather than listed flat: the daemon emits channels sorted
    by position across ALL servers, so a flat list interleaves them and reads as
    noise. The built-in module groups for the same reason.
    """
    rows = []
    if st.error:
        rows.append({"text": st.error, "value": "", "enabled": False})
    elif st.username:
        rows.append({"text": f"{st.username}  ·  {st.label()}", "value": "",
                     "enabled": False})
    else:
        rows.append({"text": st.label(), "value": "", "enabled": False})

    if st.state == "connected":
        rows.append({"separator": True})
        rows.append({"text": "Unmute" if st.muted else "Mute",
                     "value": "do:mute", "selected": st.muted})
        rows.append({"text": "Disconnect", "value": "do:leave"})

    rows.append({"separator": True})
    if st.linked:
        if st.state == "offline":
            rows.append({"text": "Connect to Discord", "value": "do:connect"})
        else:
            rows.append({"text": "Disconnect from Discord",
                         "value": "do:disconnect"})
        rows.append({"text": "Shut down daemon", "value": "do:dstop"})
    elif DAEMON and os.access(DAEMON, os.X_OK):
        # Installed but not running: the one state you can actually act on, and
        # the reason the pill stays visible while offline.
        rows.append({"text": "Start daemon", "value": "do:dstart"})

    if st.channels:
        by_guild = {}
        for cid, c in st.channels.items():
            by_guild.setdefault(c.get("guild", ""), []).append((cid, c))
        for gid in sorted(by_guild, key=lambda g: st.guilds.get(g, "")):
            rows.append({"separator": True})
            rows.append({"text": st.guilds.get(gid, "Server"), "value": "",
                         "enabled": False})
            for cid, c in by_guild[gid]:
                people = c.get("people", 0)
                label = c.get("name", "")
                if people:
                    label += f"  ({people})"
                rows.append({"text": "    " + label, "value": "j:" + cid,
                             "selected": cid == st.channel_id})
    return {"menu": {"item": "", "rows": rows}}


def send(st, obj):
    """One command to the daemon, on the socket it already streams events on."""
    if not st.sock:
        return
    try:
        st.sock.sendall((json.dumps(obj) + "\n").encode())
    except OSError:
        pass


def act(st, value):
    if value == "do:mute":
        send(st, {"cmd": "mute"})
    elif value == "do:leave":
        send(st, {"cmd": "disconnect"})
    elif value == "do:connect":
        send(st, {"cmd": "connect"})
    elif value == "do:disconnect":
        send(st, {"cmd": "logout"})
    elif value == "do:dstop":
        send(st, {"cmd": "quit"})
    elif value == "do:dstart":
        spawn_daemon(force=True)
    elif value.startswith("j:"):
        send(st, {"cmd": "join", "channel": value[2:]})


def reader(st):
    """Events from the compositor, on stdin.

    Its own thread because the socket read loop below blocks: the two are
    independent streams and neither may starve the other.
    """
    for line in sys.stdin:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        kind = ev.get("event")
        if kind == "click":
            emit(menu(st), menu_ok=True)
        elif kind == "menu":
            v = ev.get("value") or ""
            if not v:
                continue
            act(st, v)
            # Close the panel; the daemon's next status event redraws the pill.
            emit({"menu": {"item": "", "rows": []}}, menu_ok=True)


def spawn_daemon(spawned=[False], force=False):
    """Start the daemon once per plugin lifetime, never in a loop.

    A retry every few seconds would fork a process forever on a machine that
    does not have it installed. Once is enough: if it dies later the pill goes
    offline and stays there, which is at least predictable and visible.
    """
    if (spawned[0] and not force) or not DAEMON or not os.access(DAEMON, os.X_OK):
        return
    spawned[0] = True
    try:
        subprocess.Popen(
            [DAEMON],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


def main():
    st = State()
    threading.Thread(target=reader, args=(st,), daemon=True).start()
    backoff = 1.0
    while True:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(SOCKET)
        except OSError:
            # No daemon. Say so, offer to have started one, and back off --
            # a tight reconnect loop against a socket that is not there is
            # the one way a plugin can actually cost the machine something.
            st.linked = False
            emit(st.render())
            spawn_daemon()
            time.sleep(backoff)
            backoff = min(backoff * 2, 30.0)
            continue

        backoff = 1.0
        st.linked = True
        st.sock = s
        emit(st.render())
        with s, s.makefile("r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue  # a partial or malformed line is not fatal
                apply_event(st, ev)
                emit(st.render())

        # The daemon went away: everything we knew is stale, and showing the
        # last channel would claim a voice connection that no longer exists.
        st.sock = None
        st.reset()
        emit(st.render())


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
