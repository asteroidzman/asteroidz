misc {
    dpms-wake-retrain 1
    layerrule layer_name:exclusion,noblur:1
    drag-tile-to-tile 1
    icon-theme Papirus-Dark
    xwayland-persistence 1
    syncobj 1
    focus-on-activate 1
    // easter egg: at random intervals an Asteroids-style ship flies across the
    // bar and shoots down a UFO. Set to 0 to disable.
    ufo-easter-egg 1
    // gamescope HDR passthrough (frog-color-management-v1). Set to 0 to
    // disable entirely; gamescope falls back to wp-color-management (likely
    // without real HDR, since wlroots only implements 2 of 6 features it needs).
    frog-color-management 1
    allow-tearing 2
    sdr {
        reference-luminance 280
        saturation 1.25
    }
}
theme {
    border-width 0
    corner-radius 8
    font "Ubuntu 18"
    padding {
        x 16
        y 4
    }
}
layout {
    monocle {
        tab-max-width 380
    }
    titlebar {
        enable 1
        height 36
    }
    scroller {
        structs 20
        default-proportion 0.48
        focus-center 0
        prefer-center 0
        default-proportion-single 1.0
        preset 0.5,0.8,1.0
        edge-scroll {
            pointer-focus 1
            allow-speed 40
            enable 1
            size 15
            delay 500
        }
    }
}
overview {
    tab-mode 0
    hotarea {
        size 10
        enable 1
    }
    gaps {
        inner 5
        outer 30
    }
}
animations {
    curve spring
    spring {
        damping 0.8
        frequency 22
    }
    window-open {
        type fade
        duration 450
        fade-begin-opacity 0.0
    }
    window-close {
        type fade
        duration 375
        fade-begin-opacity 1.0
    }
}

environment {
    XDG_CURRENT_DESKTOP asteroidz
    XDG_SESSION_TYPE wayland
    QT_AUTO_SCREEN_SCALE_FACTOR 1
    QT_WAYLAND_FORCE_DPI 1.8
    QT_FONT_DPI 168
    XCURSOR_SIZE 48
    XCURSOR_THEME Adwaita
    MESA_GLTHREAD "true"
}

// Hand the environment to the session bus, so systemd --user units and
// xdg-desktop-portal see WAYLAND_DISPLAY. Needs no guard: it is a no-op without
// a bus, and everything graphical wants it.
spawn-at-startup dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

// Everything else a session starts -- the bar, the clipboard, notifications --
// lives in one script rather than in a column of lines here.
//
// Most of it is conditional: "if it is installed", "if it is not already
// running". KDL cannot say either, so a `spawn-at-startup` for something absent
// produces a shell error into the log and nothing else.
//
// Your copy first, the shipped one as a fallback, so a fresh install has a
// working session before you have edited anything.
//
// ONE quoted string, not three bare words. `spawn` joins its arguments with
// spaces and hands the result to `sh -c`, which is why `~` expands and why `||`
// works at all -- but `/` is not a legal bare-word character in KDL, so an
// unquoted path is a parse error rather than a path. Quoting the whole command
// keeps it in one piece.
spawn-at-startup "~/.config/asteroidz/autostart.sh || /etc/asteroidz/autostart.sh"

binds {
    Super+Ctrl+r { restart; }
    Super+Ctrl+l { retrain_monitor name:^DP-1$; }
    Super+Ctrl+Up { set_sdr_luminance +25; }
    Super+Ctrl+Down { set_sdr_luminance -25; }
    Super+Shift+p { pin; }
    Super+grave { toggle_special_workspace term; }
    Super+Shift+grave { move_to_special_workspace term; }
    Print { screenshot_ui region; }
    Shift+Print { screenshot_ui screen; }
    Super+Print { screenshot_ui window; }
}

mouse-binds {
    Super+btn_left { move_resize curmove; }
    NONE+btn_middle { toggle_maximize 0; }
    Super+btn_right { move_resize curresize; }
}

tag 1 { layout monocle; name web }

tag 2 { layout scroller }

tag 3 { layout tile }

tag 4 { layout tile }

tag 5 { layout tile }

tag 6 { layout tile }

tag 7 { layout tile }

tag 8 { layout tile }

tag 9 { layout tile }

window-rule { match app-id=^steam_app.*$; vrr_only_fullscreen 1 }

window-rule { match app-id=^gamescope$; vrr_only_fullscreen 1 }

// The palette, generated by matugen from the wallpaper.
//
// LAST on purpose. `source` is applied in place and later declarations win, so
// anything set above this line is overridden by the generated file -- which is
// what makes matugen the owner of the colours it writes. Turn a colour off in
// the settings window's Palette page to take it back; it then disappears from
// the generated file and whatever you set above wins again.
//
// Kept as a `source` rather than inlined because it is rewritten on every
// wallpaper change, and a generator that had to edit this file would have to
// understand it.
source "./colors.kdl"
