// The palette. Generated by matugen from the wallpaper — or this, until it is.
//
// `config.kdl` sources this file, and a missing `source` is a FATAL config error,
// not a warning. So a copy has to be installed alongside the default config: a
// fresh install that sources a file matugen has not written yet would refuse to
// start, and the place you would find that out is the login screen.
//
// These values are a real Material palette, rendered from the same nine roles the
// matugen template uses (seed #4a6fa5, dark scheme) rather than hand-picked — so
// the default desktop looks like the generated one rather than like a placeholder
// that nobody chose.
//
// ── it is overwritten ───────────────────────────────────────────────────────
//
// Once matugen is set up, every wallpaper change rewrites this file from
// `asteroidz-colors.kdl` and nothing you edit here survives. To take a colour
// back, turn it off in the settings window's Palette page — that drops it from
// the template, and your own `config.kdl` decides it from then on.
//
// The four state colours are deliberately absent: `maximize-color`,
// `scratchpad-color`, `global-color` and `overlay-color` default to
// `focus-color`, which is what keeps a themed border the same hue when a window
// is maximized. See docs/visuals/theming.md.

layout {
    border {
        // Resting borders and the native UI share one surface, desaturated:
        // surface_container_high still carries a hue tint from the seed, which
        // reads as too colourful for something that is meant to recede.
        color 0x2a2a2aff
        focus-color 0xa7c8ffff
        urgent-color 0xffb4abff
        // The far end of the focused border's gradient. Pairs with focus-color.
        gradient { color2 0xdbbde2ff }
    }
}

// Every native overlay: the monocle tab bar, titlebars, jump-mode labels, the
// screenshot UI.
theme {
    bg-color 0x2a2a2aff
    fg-color 0xe1e2e9ff
    focus-bg-color 0xa7c8ffff
    focus-fg-color 0x03305fff
    urgent-color 0xffb4abff
}
